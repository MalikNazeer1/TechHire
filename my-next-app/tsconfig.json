{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "src/app/homepage/SignIn/page.jsx",
    "src/app/dashboard/page.tsx",
    "src/app/dashboard/manager/page.tsx",
    "src/app/page.jsx",
    "src/components/ui/calendar.jsx",
    "src/app/dashboard/ScheduleInterview/page.jsx",
    "src/app/api/companies/jobDescriptions/route.jse.js",
    "src/app/api/admin/interviews/completed/route.js",
    "src/components/reports/PdfDownloadButton.jsx",
    "src/app/api/recordings/[roomId]/route.js"
  ],
  "exclude": ["node_modules"]
}
