# Copy this file to .env and fill in your own values.

# --- Database (PostgreSQL, e.g. Supabase) ---
DATABASE_URL=
DIRECT_URL=

# --- Authentication (NextAuth + Google OAuth) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Real-time interview room (Socket.IO on 3001 + PeerJS on 9000, started by ../server.js) ---
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
NEXT_PUBLIC_PEER_HOST=localhost
NEXT_PUBLIC_PEER_PORT=9000
NEXT_PUBLIC_PEER_SECURE=false

# --- Collaborative code editor (Liveblocks) ---
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=

# --- Code execution (Piston via docker-compose) ---
CODE_EXECUTION_SERVICE_URL=http://localhost:3001
PISTON_API_BASE_URL=http://localhost:2000

# --- Interview recordings (AWS S3) ---
NEXT_PUBLIC_AWS_REGION=
NEXT_PUBLIC_AWS_S3_BUCKET=
NEXT_PUBLIC_AWS_ACCESS_KEY_ID=
NEXT_PUBLIC_AWS_SECRET_ACCESS_KEY=
